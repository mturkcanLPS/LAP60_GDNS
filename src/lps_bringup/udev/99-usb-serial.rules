# STM32 Black Pill USB-TTL (0483:5740, CDC ACM -> ttyACMx) -> /dev/ttyBlackPill
# 18_11'den beri HRVS radar adaptoru (arkadasin yazdigi kopru yazilimi). 0483:5740 STM32 VCP'nin
# genel kimligi: baska bir STM32 VCP takilirsa o da bu adi alir. ID_MM_DEVICE_IGNORE: ModemManager
# (kuruluysa) ACM portlarina AT komutu yollar -> radara cop bayt gitmesin.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", SYMLINK+="ttyBlackPill", GROUP="dialout", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"

# FTDI FT232R (0403:6001) -> /dev/ttyFTDI   (19_11'den beri HRVS radar adaptoru)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="ttyFTDI", GROUP="dialout", MODE="0666"
# FTDI gecikme sayaci 16 ms (varsayilan) -> 1 ms: radarin buyuk paketleri (2500 B) parca parca
# gecikmesin / SDK zaman asimina dusmesin.
ACTION=="add", SUBSYSTEM=="usb-serial", DRIVER=="ftdi_sio", ATTR{latency_timer}="1"

# CP210x  (10c4:ea60) -> /dev/ttyCP210x
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="ttyCP210x", GROUP="dialout", MODE="0666"

# CH340   (1a86:7523) -> /dev/ttyCH340
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="ttyCH340", GROUP="dialout", MODE="0666"
