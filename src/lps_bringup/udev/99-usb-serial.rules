# CP210x  (10c4:ea60) -> /dev/ttyCP210x
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="ttyCP210x", GROUP="dialout", MODE="0666"

# CH340   (1a86:7523) -> /dev/ttyCH340
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="ttyCH340", GROUP="dialout", MODE="0666"
